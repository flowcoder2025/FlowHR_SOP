      "applicable_screens": ["OP-08", "TA-09", "EM-05", "EM-11"],
      "components": ["master-detail-shell", "master-list", "master-list-filter", "master-item", "master-detail-pane"],
      "showcase_anchor": "_showcase.html#section-master-detail",
      "allowed_classes": ["master-detail-shell", "master-list", "master-list-filter", "master-list-body", "master-item", "master-item is-active", "master-detail-pane"],

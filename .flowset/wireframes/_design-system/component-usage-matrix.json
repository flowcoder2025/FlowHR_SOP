      "applicable_screens": ["OP-03", "OP-12", "TA-03", "EM-09"],
      "components": ["header-cards", "header-card", "tabs-row", "tab", "tab-pane", "form-section", "form-row", "modal-overlay", "modal-box", "btn-danger"],

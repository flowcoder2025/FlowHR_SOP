      "allowed_classes": ["auth-shell", "auth-header", "auth-header-actions", "auth-lang-toggle", "auth-lang-current", "auth-lang-divider", "auth-main", "auth-card", "auth-card-narrow", "auth-card-wide", "auth-brand", "auth-brand-title", "auth-brand-subtitle", "auth-alert", "auth-alert-error", "auth-alert-warning", "auth-alert-info", "auth-alert-success", "auth-alert-meta", "auth-aux", "auth-hero", "auth-hero-code", "auth-hero-title", "auth-hero-desc", "auth-hero-actions", "password-field", "password-toggle", "otp-group", "otp-input"],
      "react_mapping": "apps/web/app/(auth)/layout.tsx"
    },

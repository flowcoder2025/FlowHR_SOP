      "applicable_screens": ["OP-04", "CM-03"],
      "components": ["wizard-shell", "stepper", "step", "form-section", "module-toggle", "review-table", "auth-alert"],
      "showcase_anchor": "_showcase.html#section-wizard",
      "allowed_classes": ["stepper", "step", "step is-active", "step is-completed", "step-num", "step-num-text", "step-label", "form-section", "input", "select", "select-wrap", "checkbox", "file-input", "date-input", "auth-alert", "auth-alert-info", "auth-alert-warning", "btn-primary", "btn-ghost"],

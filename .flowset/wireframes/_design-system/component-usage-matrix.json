  "forbidden_global": [
    {
      "pattern": "외부 SVG <use href=\"../_design-system/icons.svg#...\">",
      "reason": "Chrome/Safari가 file:// 프로토콜에서 차단",
      "fix": "화면 HTML에 인라인 svg sprite 추가 또는 _layout-{shell,auth}.html 복사 (sprite 포함)",
      "ci_check": "inline-svg-sprite-check"
    },
    {
      "pattern": "<select> without .select class",
      "reason": "OS 기본 chevron + 옵션 패널 노출 → 디자인 시스템 시각 불일치",
      "fix": "<select class=\"select\"> + 옵션 .select-wrap 추가",
      "ci_check": "native-element-wrap-check"
    },
    {
      "pattern": "<input type=\"file\"> without .file-input wrapper",
      "reason": "OS 기본 \"파일 선택\" 버튼 노출",
      "fix": "<label class=\"file-input\"><input type=\"file\" class=\"sr-only\">+<.file-input-btn>+<.file-input-filename></label>",
      "ci_check": "native-element-wrap-check"
    },
    {
      "pattern": "<input type=\"date|datetime-local\"> without .date-input wrapper",
      "reason": "OS 기본 calendar 아이콘 + native datepicker",
      "fix": "<div class=\"date-input\"><input class=\"input\" type=\"date\"></div>",
      "ci_check": "native-element-wrap-check"
    },
    {
      "pattern": "화면 inline <style>에서 .modal / .switch / .stepper / .toggle-pill 등 컴포넌트 재정의",
      "reason": "DS SSOT 위반 — components.css 단일 source 정책",
      "fix": "components.css에 등록 후 화면은 클래스만 사용",
      "ci_check": "ds-redefinition-check (기존 design-system-ssot 확장)"
    }
  ],


      "applicable_screens": ["CM-21"],
      "components": ["legal-shell", "legal-toc", "legal-body", "legal-meta", "legal-consent"],
      "showcase_anchor": "_showcase.html#section-legal",
      "allowed_classes": ["legal-shell", "legal-toc", "legal-toc-title", "legal-body", "legal-meta", "legal-consent", "auth-alert-info", "version-change"],
      "react_mapping": "react-markdown + remark-toc + react-hook-form 동의 폼"
    },
    {
      "prd_pattern": "PWA Install Guide",
      "applicable_screens": ["CM-20"],
      "components": ["install-grid", "install-card", "auth-alert-warning"],
      "showcase_anchor": "_showcase.html#section-install",
      "allowed_classes": ["install-grid", "install-card", "install-card-header", "install-steps", "auth-alert-warning", "auth-alert-success"],
      "react_mapping": "beforeinstallprompt + iOS Safari manual guide"
    },
    {
      "prd_pattern": "File Input (DS wrap, native 차단)",
      "applicable_screens": ["OP-04", "TA-02", "TA-10", "TA-13"],
      "components": ["file-input", "file-input-btn", "file-input-filename"],
      "showcase_anchor": "_showcase.html#section-file-input",
      "allowed_classes": ["file-input", "file-input-btn", "file-input-filename", "sr-only"],
      "forbidden_patterns": ["bare <input type=\"file\"> without .file-input wrapper"],
      "react_mapping": "react-dropzone + custom UploadButton"
    },
    {
      "prd_pattern": "Date Input (DS wrap, native calendar 차단)",
      "applicable_screens": ["OP-04", "OP-06", "OP-11", "TA-05", "TA-07", "EM-03"],
      "components": ["date-input"],
      "showcase_anchor": "_showcase.html#section-date-input",
      "allowed_classes": ["date-input", "date-input is-error"],
      "forbidden_patterns": ["bare <input type=\"date|datetime-local\"> without .date-input wrapper"],
      "react_mapping": "react-day-picker (Phase 7) — wireframe은 native + 커스텀 chevron"
    },
    {
      "prd_pattern": "Select (DS wrap, native chevron 차단)",
      "applicable_screens": ["전 화면"],
      "components": ["select", "select-wrap", "select-sm"],
      "showcase_anchor": "_showcase.html#section-select",
      "allowed_classes": ["select", "select-wrap", "select-wrap is-error", "select-wrap is-disabled", "select-sm"],
      "forbidden_patterns": ["<select> 클래스 .select 누락 (bare native chevron 노출)"],
      "react_mapping": "shadcn/ui Select"
    }
  ],

  "forbidden_global": [
    {
      "pattern": "외부 SVG <use href=\"../_design-system/icons.svg#...\">",
      "reason": "Chrome/Safari가 file:// 프로토콜에서 차단",
      "fix": "화면 HTML에 인라인 svg sprite 추가 또는 _layout-{shell,auth}.html 복사 (sprite 포함)",
      "ci_check": "inline-svg-sprite-check"
    },
    {
      "pattern": "<select> without .select class",
      "reason": "OS 기본 chevron + 옵션 패널 노출 → 디자인 시스템 시각 불일치",
      "fix": "<select class=\"select\"> + 옵션 .select-wrap 추가",
      "ci_check": "native-element-wrap-check"
    },
    {
      "pattern": "<input type=\"file\"> without .file-input wrapper",
      "reason": "OS 기본 \"파일 선택\" 버튼 노출",
      "fix": "<label class=\"file-input\"><input type=\"file\" class=\"sr-only\">+<.file-input-btn>+<.file-input-filename></label>",
      "ci_check": "native-element-wrap-check"
    },
    {
      "pattern": "<input type=\"date|datetime-local\"> without .date-input wrapper",
      "reason": "OS 기본 calendar 아이콘 + native datepicker",
      "fix": "<div class=\"date-input\"><input class=\"input\" type=\"date\"></div>",
      "ci_check": "native-element-wrap-check"
    },
    {
      "pattern": "화면 inline <style>에서 .modal / .switch / .stepper / .toggle-pill 등 컴포넌트 재정의",
      "reason": "DS SSOT 위반 — components.css 단일 source 정책",
      "fix": "components.css에 등록 후 화면은 클래스만 사용",
      "ci_check": "ds-redefinition-check (기존 design-system-ssot 확장)"
    }
  ],

  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-05-16",
      "wi": "WI-RSv3 + WI-KI-batch-006",
      "changes": [
        "신규 매트릭스 — 14 PRD 패턴 + 5 forbidden_global 패턴 정의",
        "Codex 협의 합의안 §2-4 반영"
      ]
    }
  ]
}

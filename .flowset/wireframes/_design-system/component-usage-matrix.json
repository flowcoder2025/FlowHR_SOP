{
  "$schema": "./component-usage-matrix.schema.json",
  "version": "1.0.0",
  "updated_at": "2026-05-16",
  "source_of_truth": ".flowset/wireframes/_design-system/component-usage-matrix.json",
  "spec_ref": ".flowset/contracts/review-system.md §17-4 (Codex 합의안)",
  "description": "PRD 패턴 → 디자인 시스템 컴포넌트 → showcase 앵커 → React 매핑. 화면 작성 시 본 매트릭스 매핑 의무 (CI showcase-coverage-check 검증).",

  "patterns": [
    {
      "prd_pattern": "AppShell (사이드바 + 헤더 + 콘텐츠 + 푸터)",
      "applicable_screens": ["OP-01~12", "TA-01~14", "EM-01~11"],
      "components": ["app-shell", "sidebar", "sidebar-item", "header", "page-title", "header-search", "icon-btn", "badge-dot", "profile-trigger", "avatar", "content", "footer", "footer-links"],
      "showcase_anchor": "_showcase.html#section-shell",
      "allowed_classes": ["app-shell", "sidebar", "sidebar-logo", "sidebar-menu", "sidebar-section-label", "sidebar-item", "sidebar-item active", "sidebar-footer", "main", "header", "page-title", "header-search-wrap", "header-search", "header-actions", "icon-btn", "badge-dot", "profile-trigger", "avatar", "content", "footer", "footer-links", "footer-version"],
      "react_mapping": "apps/web/app/(operator|admin|me)/layout.tsx — Next.js layout + shadcn/ui Sidebar"
    },
    {
      "prd_pattern": "Auth Layout (비인증 영역)",
      "applicable_screens": ["CM-01~06", "CM-20", "CM-21"],
      "components": ["auth-shell", "auth-header", "auth-lang-toggle", "auth-main", "auth-card", "auth-brand", "auth-alert", "auth-aux", "auth-hero", "password-field", "password-toggle", "otp-group", "otp-input"],

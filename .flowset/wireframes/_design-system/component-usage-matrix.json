      "applicable_screens": ["OP-11", "TA-13"],
      "components": ["vert-tabs", "vert-tab", "switch", "form-section", "form-row"],
      "showcase_anchor": "_showcase.html#section-vert-tabs",
      "allowed_classes": ["vert-tabs", "vert-tab", "vert-tab is-active", "form-section", "form-row", "input", "select", "select-wrap", "switch", "auth-alert"],

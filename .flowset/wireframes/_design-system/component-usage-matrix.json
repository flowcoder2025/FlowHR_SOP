      "applicable_screens": ["OP-07"],
      "components": ["table", "toggle-pill", "switch", "module-chip"],
      "showcase_anchor": "_showcase.html#section-toggle-table",
      "allowed_classes": ["table", "toggle-pill", "toggle-pill is-on", "toggle-pill is-off", "toggle-pill is-beta", "switch", "switch is-on"],
      "react_mapping": "shadcn/ui Switch + DataTable"
    },
    {
